{
  "name": "cerebro",
  "version": "0.9.4",
  "private": true,
  "description": "cerebro - elasticsearch admin",
  "type": "module",
  "scripts": {
    "start": "ng build --configuration development --watch",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "audit": "audit-ci --config audit-ci.jsonc"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/router": "22.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "ace-builds": "1.44.0",
    "bootstrap-icons": "1.13.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.3",
    "@types/node": "24.3.0",
    "audit-ci": "7.1.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ansi-regex": "5.0.1",
    "body-parser": "1.20.6",
    "brace-expansion": "1.1.18",
    "braces": "3.0.3",
    "follow-redirects": "1.15.12",
    "minimatch": "3.1.4",
    "qs": "6.15.3",
    "tmp": "0.2.6"
  },
  "license": "MIT"
}
